# Copy to .env and fill in. Never commit .env.

# Supabase (required for auth, quiz persistence, shared results)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Google AdSense (optional — omit or leave empty to skip loading ad scripts)
# VITE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx

# Optional production errors (configured in Cloudflare Pages, not secrets in Git)
# VITE_SENTRY_DSN=https://PUBLIC_KEY@o123.ingest.sentry.io/123456
